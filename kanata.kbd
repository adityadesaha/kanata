;; adi's kanata config

;;; Configuration

(defcfg
  process-unmapped-keys yes)

;;; Source layout

(defsrc
  esc
  grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
  tab    q      w      e      r      t      y      u      i      o      p      [      ]      \
  caps   a      s      d      f      g      h      j      k      l      ;      '      ret
  lsft   z      x      c      v      b      n      m      ,      .      /      rsft
  lctl   lmet   lalt                        spc                  ralt   sys    rctl)

;;; Variables

(defvar
  tap-time      150
  hold-time     300
  one-shot-time 2000

  ;; physical (defsrc) keys per hand, used so that a same-hand roll
  ;; resolves a tap-hold as a tap instead of triggering the hold
  left-hand-keys  (q w e r t
                   a s d f g
                   z x c v b)
  right-hand-keys (y u i o p
                   h j k l ;
                   n m , . /))

;;; Templates

;; Tap-hold that resolves to tap when a key from `same-hand` is pressed
;; during the hold window. Used for bottom-row mods and layer-taps.
(deftemplate th (key hold same-hand)
  (tap-hold-release-keys $tap-time $hold-time $key $hold $same-hand))

;;; Aliases

(defalias
  ;; lalt: tap = caps lock, hold = alt
  lalt   (tap-hold-press $tap-time $hold-time caps lalt)

  ;; bottom-row mods
  xalt   (t! th x lalt $left-hand-keys)
  cctl   (t! th c lctl $left-hand-keys)
  dsft   (t! th d lsft $left-hand-keys)
  hsft   (t! th h rsft $right-hand-keys)
  ,ctl   (tap-hold-release $tap-time $hold-time , rctl)
  .alt   (t! th . ralt $right-hand-keys)

  ;; layer-tap
  fnav   (t! th f (layer-while-held navigation) $left-hand-keys)

  ;; tap: one-shot shift, hold: meta
  lsft   (tap-hold-release $tap-time $hold-time (one-shot-press $one-shot-time lsft) lmet)
  rsft   (tap-hold-release $tap-time $hold-time (one-shot-press $one-shot-time rsft) rmet)

  ;; swap : and ;
  semi   (fork S-; (unshift ;) (sft))

  ;; readline: C-w -> C-bspc, C-x -> C-w
  wrl    (switch (lctl rctl) bspc break () w break)
  xaltr  (t! th (switch (lctl rctl) w break () x break) lalt $left-hand-keys)

  ;; layer switching
  to-adi     (layer-switch colemak-adi)
  to-adi-rl  (layer-switch colemak-adi-readline)
  to-qwerty  (layer-switch qwerty))

;;; Layers

;; The first layer defined is the default.

;;;; Colemak-adi

;; Current problems with colemak-adi:
;; 1. number rows are harder to deal with. Solution: learn better touchtyping
;; 2. harder to press the right shift key. Solution: better pinky control,
;;                                                   better hand position.
(deftemplate colemak-adi-layer (name w x ralt)
  (deflayer $name
    caps
    grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
    tab    q      $w     @fnav  p      b      [      j      l      u      y      @semi  '      \
    esc    a      r      s      t      g      ]      m      n      e      i      o      ret
    @lsft  $x     @cctl  @dsft  v      z      /      k      @hsft  @,ctl  @.alt  @rsft
    lctl   lmet   @lalt                       spc                  $ralt  lrld   rctl))

;; ralt toggles colemak-adi <-> qwerty.
;; colemak-adi-readline is currently unreachable (@to-adi-rl is unbound).
;;                    name                  w     x       ralt
(t! colemak-adi-layer colemak-adi           w     @xalt   @to-qwerty)
(t! colemak-adi-layer colemak-adi-readline  @wrl  @xaltr  @to-qwerty)

;;;; Qwerty

(deflayermap (qwerty)
  ralt @to-adi)

;;;; Navigation

;; Shifted one key right of hjkl, to match colemak-adi.
(deflayermap (navigation)
  ;; motion
  j left
  k down
  l up
  ; right

  f lctl

  ;; editing
  u C-bspc
  p C-del
  i bspc
  o del
  ' ret)
