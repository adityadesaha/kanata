;; adi's kanata config

;;; Configuration

(defcfg
  process-unmapped-keys yes)

;;; Source layout

(defsrc
  grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
  tab    q      w      e      r      t      y      u      i      o      p      [      ]      \
  caps   a      s      d      f      g      h      j      k      l      ;      '      ret
  lsft   z      x      c      v      b      n      m      ,      .      /      rsft
  lctl   lmet   lalt                        spc                  ralt   sys    rctl)

;;; Variables

(defvar
  tap-time      150
  hold-time     300
  one-shot-time 2000

  ;; physical (defsrc) keys per hand, used so that a same-hand roll
  ;; resolves a tap-hold as a tap instead of triggering the hold
  left-hand-keys  (q w e r t
                   a s d f g
                   z x c v b)
  right-hand-keys (y u i o p
                   h j k l ;
                   n m , . /))

;;; Templates

;; Tap-hold that resolves to tap when a key from `same-hand` is pressed
;; during the hold window. Used for bottom-row mods and layer-taps.
(deftemplate th (key hold same-hand)
  (tap-hold-release-keys $tap-time $hold-time $key $hold $same-hand))

;;; Aliases

(defalias
  ;; tap = caps lock, hold = ralt
  altcaps (tap-hold-press $tap-time $hold-time caps ralt)

  ;; bottom-row mods
  xalt (t! th x lalt $left-hand-keys)
  cctl (t! th c lctl $left-hand-keys)
  dsft (t! th d lsft $left-hand-keys)
  hsft (t! th h rsft $right-hand-keys)
  ,ctl (tap-hold-release $tap-time $hold-time , rctl)
  .alt (t! th . ralt $right-hand-keys)

  ;; layer-tap
  fnav (t! th f (layer-while-held navigation) $left-hand-keys)

  ;; tap: one-shot shift, hold: meta
  lsft (tap-hold-release $tap-time $hold-time (one-shot-press $one-shot-time lsft) lmet)
  rsft (tap-hold-release $tap-time $hold-time (one-shot-press $one-shot-time rsft) rmet)

  ;; swap : and ;
  semi (fork S-; (unshift ;) (sft))

  ;; layer switching
  to-adi    (layer-switch adi-colemak)
  to-qwerty (layer-switch qwerty))

;;; Layers

;; The first layer defined is the default.

;;;; Colemak-adi

(deflayer adi-colemak
    grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
    tab    q      w      @fnav  p      b      [      j      l      u      y      @semi  '      \
    esc    a      r      s      t      g      ]      m      n      e      i      o      ret
    @lsft  x      @cctl  @dsft  v      z      /      k      @hsft  @,ctl  @.alt  @rsft
    lctl   lmet   @to-qwerty                 spc         @altcaps sys   rctl)

;;;; Qwerty

(deflayermap (qwerty)
  lalt @to-adi)

;;;; Navigation

;; Shifted one key right of hjkl, to match colemak-adi.
(deflayermap (navigation)
  ;; motion
  j left
  k down
  l up
  ; right

  ;; easy access to the ctrl key, so I can press ctrl+arrow keys easily
  f lctl

  ;; killing text
  u C-bspc
  p C-del
  i bspc
  o del

  ;; big keys on the bottom row.
  m    home
  ,    pgdn
  .    pgup
  /    end
  rsft end

  ;; random binding that saves my pinky
  ' ret)
